# Copy this file to .env.local (gitignored) for local development,
# and set the same variables in your production host's environment settings.

# Required. API key from https://resend.com/api-keys.
# Without this, POST /api/contact returns 500 and logs a clear server-side error.
RESEND_API_KEY= 

# Optional. Verified sender address for outgoing contact-form emails.
# Defaults to "Portfolio Contact <onboarding@resend.dev>", which works without
# domain verification but can only deliver to the Resend account's own email.
# Once a custom domain is verified in Resend, set this to an address on that domain.
RESEND_FROM_EMAIL=
